{#
 # FirmarAhora - página pública de verificación (Controller/VerificarFirma).
 #}
{% extends "Master/MicroTemplate.html.twig" %}

{% block body %}
	{{ parent() }}
	<div class="fa-publica">
		<div class="fa-publica-cabecera">
			<div class="container d-flex align-items-center gap-2">
				<i class="fa-solid fa-shield-halved fa-lg"></i>
				<span class="fw-semibold">{{ trans('fa-verify-title') }}</span>
			</div>
		</div>
		<div class="container fa-publica-cuerpo">
			<div class="card fa-tarjeta mb-4">
				<div class="card-body">
					<form method="get" action="{{ asset('VerificarFirma') }}" class="row g-2 align-items-end">
						<div class="col-md-8">
							<label class="form-label" for="c">{{ trans('fa-verification-code') }}</label>
							<input type="text" name="c" id="c" class="form-control form-control-lg fa-codigo" maxlength="20"
								   value="{{ fsc.codigo }}" placeholder="FA-XXXX-XXXX" required>
						</div>
						<div class="col-md-4">
							<button type="submit" class="btn btn-primary btn-lg w-100">{{ trans('fa-verify') }}</button>
						</div>
					</form>
				</div>
			</div>

			{% if fsc.solicitud %}
				{% set sol = fsc.solicitud %}
				<div class="card fa-tarjeta mb-4">
					<div class="card-body">
						<div class="text-muted small">{{ trans('document') }}</div>
						<h1 class="h5">{{ sol.doc_titulo }}</h1>
						<div class="table-responsive mt-3">
							<table class="table align-middle mb-0">
								<thead>
								<tr>
									<th>{{ trans('fa-role') }}</th>
									<th>{{ trans('fa-signer') }}</th>
									<th>{{ trans('status') }}</th>
									<th>{{ trans('fa-signed-at') }}</th>
									<th>{{ trans('fa-otp') }}</th>
								</tr>
								</thead>
								<tbody>
								{% for f in fsc.firmantes %}
									<tr>
										<td><b>{{ f.rol }}</b><br><span class="small text-muted fa-codigo">{{ f.codigo }}</span></td>
										<td>{{ f.estado == 'firmada' ? f.firmante_nombre ~ ' · ' ~ f.nifOculto() : '-' }}</td>
										<td><span class="fa-estado fa-estado-{{ f.estado }}">{{ trans('fa-status-' ~ f.estado) }}</span></td>
										<td>{{ f.firmado ?: '-' }}</td>
										<td>{{ f.estado == 'firmada' ? (f.otp_verificado ? trans('yes') : trans('no')) : '-' }}</td>
									</tr>
								{% endfor %}
								</tbody>
							</table>
						</div>
						{% if sol.hash_sellado %}
							<div class="mt-3 small">
								<span class="text-muted">{{ trans('fa-hash-sealed') }} ({{ sol.codigo }}):</span>
								<div class="fa-hash">{{ sol.hash_sellado }}</div>
							</div>
						{% endif %}
					</div>
				</div>

				<div class="card fa-tarjeta">
					<div class="card-body">
						<h2 class="h6"><i class="fa-solid fa-file-circle-check fa-fw"></i> {{ trans('fa-check-file') }}</h2>
						<p class="text-muted small">{{ trans('fa-check-file-help') }}</p>
						<form method="post" action="{{ asset('VerificarFirma') }}?c={{ sol.codigo }}" enctype="multipart/form-data" class="d-flex flex-wrap gap-2">
							{{ formToken() }}
							<input type="file" name="pdf" class="form-control" accept="application/pdf" required style="max-width: 420px;">
							<button type="submit" class="btn btn-outline-primary">{{ trans('fa-check') }}</button>
						</form>
						{% if fsc.coincide is not null %}
							<div class="alert mt-3 mb-0 {{ fsc.coincide ? 'alert-success' : 'alert-danger' }}">
								<b>{{ fsc.coincide ? trans('fa-file-matches') : trans('fa-file-differs') }}</b>
								<div class="fa-hash mt-1">SHA-256: {{ fsc.huellaSubida }}</div>
							</div>
						{% endif %}
					</div>
				</div>
			{% endif %}
		</div>
	</div>
{% endblock %}

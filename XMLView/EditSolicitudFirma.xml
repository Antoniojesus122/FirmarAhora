<?xml version="1.0" encoding="UTF-8"?>
<!--
 * Sólo los datos editables de la invitación. El estado y las evidencias se muestran en
 * la pestaña Tab/EvidenciasSolicitud, de sólo lectura: así ningún formulario los puede cambiar.
-->
<view>
    <columns>
        <group name="request" title="fa-request" icon="fa-solid fa-envelope-open-text" numcolumns="12">
            <column name="id" display="none" order="100">
                <widget type="text" fieldname="id"/>
            </column>
            <column name="fa-role" numcolumns="3" order="110">
                <widget type="text" fieldname="rol" maxlength="50"/>
            </column>
            <column name="name" numcolumns="3" order="120">
                <widget type="text" fieldname="nombre" maxlength="100"/>
            </column>
            <column name="email" numcolumns="4" order="130">
                <widget type="text" fieldname="email" icon="fa-solid fa-envelope" maxlength="100"/>
            </column>
            <column name="fa-expires" numcolumns="2" order="140">
                <widget type="date" fieldname="caduca"/>
            </column>
        </group>
    </columns>
</view>

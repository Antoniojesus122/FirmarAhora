<?xml version="1.0" encoding="UTF-8"?>
<view>
    <columns>
        <column name="code" order="100">
            <widget type="text" fieldname="id"/>
        </column>
        <column name="name" order="110">
            <widget type="text" fieldname="nombre"/>
        </column>
        <column name="subject" order="120">
            <widget type="text" fieldname="asunto"/>
        </column>
        <column name="fa-otp" display="center" order="130">
            <widget type="checkbox" fieldname="requiere_otp"/>
        </column>
        <column name="date" display="right" order="140">
            <widget type="datetime" fieldname="creado"/>
        </column>
    </columns>
</view>

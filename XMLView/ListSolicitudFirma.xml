<?xml version="1.0" encoding="UTF-8"?>
<view>
    <columns>
        <column name="code" order="100">
            <widget type="text" fieldname="codigo"/>
        </column>
        <column name="document" order="110">
            <widget type="text" fieldname="doc_titulo"/>
        </column>
        <column name="fa-role" order="120">
            <widget type="text" fieldname="rol"/>
        </column>
        <column name="fa-signer" order="130">
            <widget type="text" fieldname="nombre"/>
        </column>
        <column name="email" order="140">
            <widget type="text" fieldname="email"/>
        </column>
        <column name="status" order="150">
            <widget type="select" fieldname="estado" translate="true">
                <values title="fa-status-pendiente">pendiente</values>
                <values title="fa-status-vista">vista</values>
                <values title="fa-status-firmada">firmada</values>
                <values title="fa-status-rechazada">rechazada</values>
                <values title="fa-status-caducada">caducada</values>
                <values title="fa-status-anulada">anulada</values>
            </widget>
        </column>
        <column name="fa-signed-at" display="right" order="160">
            <widget type="datetime" fieldname="firmado"/>
        </column>
        <column name="fa-expires" display="right" order="170">
            <widget type="date" fieldname="caduca"/>
        </column>
        <column name="date" display="right" order="180">
            <widget type="datetime" fieldname="creado"/>
        </column>
    </columns>
    <rows>
        <row type="status">
            <option color="success" title="fa-status-firmada" fieldname="estado">firmada</option>
            <option color="info" title="fa-status-vista" fieldname="estado">vista</option>
            <option color="danger" title="fa-status-rechazada" fieldname="estado">rechazada</option>
            <option color="secondary" title="fa-status-caducada" fieldname="estado">caducada</option>
            <option color="secondary" title="fa-status-anulada" fieldname="estado">anulada</option>
        </row>
    </rows>
</view>
